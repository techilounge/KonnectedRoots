rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function authed() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function under5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // IMPORTANT: use (default) when reading Firestore from Storage rules
    // Check if user is owner OR has edit permissions (editor/manager)
    function canEditTree(treeId) {
      let treeData = firestore.get(/databases/(default)/documents/trees/$(treeId)).data;
      let uid = request.auth.uid;
      return authed() && (
        treeData.ownerId == uid || 
        (uid in treeData.collaborators && (treeData.collaborators[uid] == 'editor' || treeData.collaborators[uid] == 'manager'))
      );
    }

    // Check if user can read (owner OR any collaborator role)
    function canReadTree(treeId) {
      let treeData = firestore.get(/databases/(default)/documents/trees/$(treeId)).data;
      let uid = request.auth.uid;
      return authed() && (
        treeData.ownerId == uid || 
        uid in treeData.collaborators
      );
    }

    // Storage quota is evaluated against server-owned billing/usage fields. A
    // paid Family workspace uses its shared family counter; otherwise the
    // owner's user counter is used. Clients cannot raise either counter.
    function quotaBytes(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      let hasBilling = user.keys().hasAny(['billing']);
      let hasFamily = user.keys().hasAny(['family']) && user.family.keys().hasAny(['familyId']) && user.family.familyId != null;
      let family = hasFamily ? firestore.get(/databases/(default)/documents/families/$(user.family.familyId)).data : null;
      let familyPaid = hasFamily && family != null && family.keys().hasAny(['plan']) &&
        (family.plan.status == 'active' || family.plan.status == 'trialing');
      let paid = hasBilling && (user.billing.status == 'active' || user.billing.status == 'trialing');
      return familyPaid ? 100 * 1024 * 1024 * 1024 :
             paid && user.billing.plan == 'pro' ? 50 * 1024 * 1024 * 1024 :
             1 * 1024 * 1024 * 1024;
    }

    function storageUsedBytes(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      let hasFamily = user.keys().hasAny(['family']) && user.family.keys().hasAny(['familyId']) && user.family.familyId != null;
      let family = hasFamily ? firestore.get(/databases/(default)/documents/families/$(user.family.familyId)).data : null;
      let familyPaid = hasFamily && family != null && family.keys().hasAny(['plan']) &&
        (family.plan.status == 'active' || family.plan.status == 'trialing');
      let hasFamilyUsage = familyPaid && family.keys().hasAny(['usage']) && family.usage.keys().hasAny(['storageUsedBytes']);
      let hasUsage = user.keys().hasAny(['usage']) && user.usage.keys().hasAny(['storageUsedBytes']);
      return hasFamilyUsage ? family.usage.storageUsedBytes : hasUsage ? user.usage.storageUsedBytes : 0;
    }

    function withinQuota(uid, additionalBytes) {
      return storageUsedBytes(uid) + additionalBytes <= quotaBytes(uid);
    }

    // Profile photos & media for people inside trees
    match /trees/{treeId}/people/{personId}/{fileName} {
      // SECURITY NOTE: Currently public read for shared tree previews and exports.
      // URLs are unpredictable (tree ID + person ID + filename).
      // To require authentication, change to: allow read: if canReadTree(treeId);
      allow read: if true;

      // User must have edit rights to the tree
      allow create: if canEditTree(treeId) && isImage() && under5MB() && withinQuota(firestore.get(/databases/(default)/documents/trees/$(treeId)).data.ownerId, request.resource.size);
      // On replacement, only the positive size delta consumes quota. The
      // existing object is available as `resource` for update requests.
      allow update: if canEditTree(treeId) && isImage() && under5MB() && withinQuota(
        firestore.get(/databases/(default)/documents/trees/$(treeId)).data.ownerId,
        request.resource.size > resource.size ? request.resource.size - resource.size : 0
      );
      allow delete: if canEditTree(treeId);
    }

    // (Optional but recommended) add a Storage rule for user avatars
    match /users/{uid}/profile/{fileName} {
      allow read: if true; // or authed() if you prefer private
      allow create: if authed() && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && withinQuota(uid, request.resource.size);
      allow update: if authed() && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && withinQuota(uid, request.resource.size > resource.size ? request.resource.size - resource.size : 0);
      allow delete: if authed() && request.auth.uid == uid;
    }
  }
}
