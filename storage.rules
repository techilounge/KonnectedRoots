rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function authed() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.contentType is string
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function canEditTree(tree) {
      return authed() && (tree.get('ownerId', '') == request.auth.uid
        || tree.get('collaborators', {}).get(request.auth.uid, '') in ['editor', 'manager']);
    }

    function paid(billing) {
      return billing is map
        && billing.get('status', 'none') in ['active', 'trialing']
        && billing.get('currentPeriodEnd', 0) is number
        && billing.get('currentPeriodEnd', 0) > request.time.toMillis()
        && (billing.get('scheduledCancellationAt', null) == null
          || (billing.get('scheduledCancellationAt', 0) is number
            && billing.get('scheduledCancellationAt', 0) > request.time.toMillis()));
    }

    function familyPaid(authority) {
      return authority is map && authority.get('plan', 'free') == 'family'
        && authority.get('status', 'none') == 'active'
        && authority.get('paidUntil', 0) is number
        && authority.get('paidUntil', 0) > request.time.toMillis();
    }

    // One user document supplies personal billing and a server-owned Family
    // projection. No Storage allow expression reads a Family document.
    function quotaBytes(user, uid) {
      let billing = user.get('billing', {});
      let authority = user.get('storageAuthority', {});
      let family = user.get('family', {});
      let linked = family is map && family.get('familyId', null) != null;
      let projected = authority is map && family is map
        && authority.get('familyId', '') == family.get('familyId', null);
      let ownerMatches = authority is map && (authority.get('ownerUid', '') != uid
        || (paid(billing) && billing.get('plan', 'free') == 'family'
          && authority.get('stripeCustomerId', '') == billing.get('stripeCustomerId', null)
          && authority.get('stripeSubscriptionId', '') == billing.get('stripeSubscriptionId', null)));
      return linked && !projected ? 0
        : projected && familyPaid(authority) && ownerMatches ? 100 * 1024 * 1024 * 1024
        : paid(billing) && billing.get('plan', 'free') == 'pro' ? 50 * 1024 * 1024 * 1024
        : 1 * 1024 * 1024 * 1024;
    }

    function nonnegativeBytes(value) {
      return value is number && value >= 0;
    }

    function withinQuota(user, uid, growth) {
      let usage = user.get('usage', {});
      let authority = user.get('storageAuthority', {});
      let used = usage is map ? usage.get('storageUsedBytes', 0) : -1;
      let floor = authority is map ? authority.get('storageUsedBytes', 0) : -1;
      // Equal/shrinking replacements remain possible above quota. Positive
      // growth uses the greater known personal/shared floor, not the full size.
      return growth <= 0 || (nonnegativeBytes(used) && nonnegativeBytes(floor)
        && (used > floor ? used : floor) + growth <= quotaBytes(user, uid));
    }

    function treeUploadAllowed(treeId, growth) {
      let tree = firestore.get(/databases/(default)/documents/trees/$(treeId)).data;
      let owner = firestore.get(/databases/(default)/documents/users/$(tree.ownerId)).data;
      return canEditTree(tree) && validImage() && withinQuota(owner, tree.ownerId, growth);
    }

    function avatarUploadAllowed(uid, growth) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return authed() && request.auth.uid == uid && validImage() && withinQuota(user, uid, growth);
    }

    function uploadGrowth() {
      return resource == null ? request.resource.size
        : request.resource.size > resource.size ? request.resource.size - resource.size : 0;
    }

    match /trees/{treeId}/people/{personId}/{fileName} {
      allow read: if true;
      allow create, update: if authed() && treeUploadAllowed(treeId, uploadGrowth());
      allow delete: if authed() && canEditTree(
        firestore.get(/databases/(default)/documents/trees/$(treeId)).data);
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow create, update: if authed() && request.auth.uid == uid && avatarUploadAllowed(uid, uploadGrowth());
      allow delete: if authed() && request.auth.uid == uid;
    }
  }
}
