rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if caller is a Platform Admin
    function isPlatformAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'super_admin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPlatformAdmin == true
        ))
      );
    }

    // A user can read/write their own user profile document.
    // Any authenticated user can query users by email (for invitations)
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for invitations and collaborator lists)
      allow read: if request.auth != null;
      // Platform admins can update any user profile; users can update their own non-privileged fields
      allow update: if isPlatformAdmin() || (
        request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billing', 'usage', 'family', 'entitlements', 'plan', 'role', 'isPlatformAdmin'])
      );
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['billing']) || request.resource.data.billing.plan == 'free')
                    && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'free')
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
    }

    // Rules for the 'trees' collection and its 'people' subcollection.
    match /trees/{treeId} {
      // Helper function to check if user is owner
      function isOwner() {
        return request.auth != null && resource.data.ownerId == request.auth.uid;
      }
      
      // Helper function to check if user is a collaborator
      function isCollaborator() {
        return request.auth != null && resource.data.collaborators[request.auth.uid] != null;
      }

      // Helper function to check collaborator role
      function hasRole(role) {
        return request.auth != null && resource.data.collaborators[request.auth.uid] == role;
      }

      // A user can create a tree for themselves.
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Owner can do anything. Collaborators can read. Managers can update.
      // Platform admins have full administrative oversight.
      allow read: if isPlatformAdmin() || isOwner() || isCollaborator();
      allow update: if isPlatformAdmin() || isOwner() || hasRole('manager');
      allow delete: if isPlatformAdmin() || isOwner();

      // Rules for the 'people' subcollection within a tree.
      match /people/{personId} {
        function rootIsOwner() {
          return get(/databases/$(database)/documents/trees/$(treeId)).data.ownerId == request.auth.uid;
        }
        
        function rootHasRole(role) {
          let treeData = get(/databases/$(database)/documents/trees/$(treeId)).data;
          return treeData.collaborators[request.auth.uid] == role;
        }
        
        function rootIsCollaborator() {
          let treeData = get(/databases/$(database)/documents/trees/$(treeId)).data;
          return treeData.collaborators[request.auth.uid] != null;
        }

        // Owner/Admin can do anything.
        // Viewers can read.
        // Editors and Managers can write.
        allow read: if isPlatformAdmin() || rootIsOwner() || rootIsCollaborator();
        allow write, delete: if isPlatformAdmin() || rootIsOwner() || rootHasRole('editor') || rootHasRole('manager');
      }

      // Rules for 'layoutHistory' subcollection
      match /layoutHistory/{snapshotId} {
        function rootIsOwner() {
          return get(/databases/$(database)/documents/trees/$(treeId)).data.ownerId == request.auth.uid;
        }
        
        function rootIsCollaborator() {
          let treeData = get(/databases/$(database)/documents/trees/$(treeId)).data;
          return treeData.collaborators[request.auth.uid] != null;
        }
        
        function rootHasRole(role) {
          let treeData = get(/databases/$(database)/documents/trees/$(treeId)).data;
          return treeData.collaborators[request.auth.uid] == role;
        }

        allow read: if isPlatformAdmin() || rootIsOwner() || rootIsCollaborator();
        allow create, delete: if isPlatformAdmin() || rootIsOwner() || rootHasRole('editor') || rootHasRole('manager');
      }
    }

    // Invitations collection for tree collaboration
    match /invitations/{invitationId} {
      function canInviteToTree(targetTreeId) {
        let tree = get(/databases/$(database)/documents/trees/$(targetTreeId)).data;
        return isPlatformAdmin() || tree.ownerId == request.auth.uid || 
               (request.auth.uid in tree.collaborators && tree.collaborators[request.auth.uid] == 'manager');
      }

      allow create: if request.auth != null 
                    && (isPlatformAdmin() || request.resource.data.inviterUid == request.auth.uid)
                    && canInviteToTree(request.resource.data.treeId);
      
      allow read: if true;
      
      allow update, delete: if isPlatformAdmin() || (request.auth != null && resource.data.inviterUid == request.auth.uid);
      
      allow update: if request.auth != null && (
        request.auth.token.email == resource.data.inviteeEmail || 
        resource.data.inviteeUid == request.auth.uid
      );
      allow delete: if request.auth != null && (
        request.auth.token.email == resource.data.inviteeEmail || 
        resource.data.inviteeUid == request.auth.uid
      );
    }

    // Notifications collection for in-app notifications
    match /notifications/{notificationId} {
      allow read: if isPlatformAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isPlatformAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow delete: if isPlatformAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Families collection for Family plan workspaces
    match /families/{familyId} {
      function isFamilyOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      
      function isFamilyMember() {
        return request.auth != null && 
          exists(/databases/$(database)/documents/families/$(familyId)/seats/$(request.auth.uid));
      }
      
      allow read: if isPlatformAdmin() || isFamilyOwner() || isFamilyMember();
      allow update: if isPlatformAdmin() || isFamilyOwner();
      allow create, delete: if isPlatformAdmin();
      
      match /seats/{seatId} {
        allow read, write: if isPlatformAdmin() || get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
        allow read: if request.auth != null && request.auth.uid == seatId;
      }
    }

    // Private AI control plane. All access goes through authenticated server actions.
    match /ai_configuration/{document=**} { allow read, write: if false; }
    match /ai_providers/{document=**} { allow read, write: if false; }
    match /ai_invocations/{document=**} { allow read, write: if false; }
    match /ai_usage_months/{document=**} { allow read, write: if false; }
    match /ai_model_health/{document=**} { allow read, write: if false; }

    // System configuration & global platform flags
    match /system/{configDoc} {
      // Public read for announcement banner and maintenance notices
      allow read: if true;
      // Only platform admins can write to system configuration
      allow write: if isPlatformAdmin();
    }

    // Platform audit logs collection
    match /audit_logs/{logId} {
      // Only platform admins can read audit logs
      allow read: if isPlatformAdmin();
      // Only platform admins or server adminDb can create audit entries
      allow create: if isPlatformAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      // Platform admins can read and update status of inquiries
      allow read, update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
      allow create: if false; // Submissions are handled via server action with adminDb
    }

    // Billing events collection (for audit trail, managed by Cloud Functions)
    match /billing_events/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
  }
}

